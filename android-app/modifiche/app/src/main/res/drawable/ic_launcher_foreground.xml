<?xml version="1.0" encoding="utf-8"?>
<!-- Modifiche: il marchio AppSphere col badge della chiave inglese.

     ⚠️ Fino alla v1.0.2 era una **chiave inglese su fondo verde petrolio**, e
     la ragione scritta allora era che «Modifiche» non è una delle app della
     suite — nessuna riga in `cm_apps`, nessuna bolla, nessun punteggio, e le
     sue tabelle non le legge nessun'altra app — quindi il marchio lì avrebbe
     detto il falso. La ragione era buona e la conclusione no: **il marchio non
     dice che è un'app della suite, dice di che famiglia è**, e questa è l'app
     con cui si cambiano le altre. Lo stesso ragionamento che ha messo il
     lucchetto su Smart Blocker e il badge SOS su SOS: stesso disegno, e a
     distinguerla nel cassetto è quel che ci sta sopra. Le APK che portano il
     marchio diventano quattro; «Spese in giro» resta fuori — quella non tocca
     né le app né i loro dati.

     ⚠️ I cinque cerchi sono la **copia identica** di
     `appsphere-native/.../ic_launcher_foreground.xml`, colori e coordinate
     compresi (vedi CLAUDE.md, «Il marchio vive in più posti»): vanno cambiati
     tutti insieme, e quel che distingue quest'app è il badge, non un disegno
     diverso.

     ⚠️ Niente esce dal **cerchio di sicurezza da 36 dp** dell'icona adattiva.
     Per i quattro cerchi esterni è r·(1+√2) = 33.8 dp; per il badge il punto
     peggiore è l'angolo alto-destro del suo alone, (80, 30) → 35.4 dp dal
     centro. Il badge ha quindi **la stessa geometria di SOS**, rientrata
     dall'angolo: sporgendo come nella foto di riferimento lo taglierebbe la
     maschera tonda, e non si vedrebbe finché non lo si prova su un launcher
     che la usa.

     ⚠️ La chiave dentro il badge è **la stessa di prima**, rimpicciolita con
     un `<group>` invece che ridisegnata a coordinate nuove: un secondo
     disegno della stessa chiave sono due chiavi che divergono il giorno che
     una delle due si ritocca. Lo `scale` porta con sé anche gli spessori dei
     tratti, che è quel che serve. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- arancio, in alto a sinistra -->
    <path
        android:fillColor="#DE8026"
        android:pathData="M40.0,40.0 m-14.0,0 a14.0,14.0 0 1,0 28.0,0 a14.0,14.0 0 1,0 -28.0,0" />

    <!-- rosso, in alto a destra -->
    <path
        android:fillColor="#CA372E"
        android:pathData="M68.0,40.0 m-14.0,0 a14.0,14.0 0 1,0 28.0,0 a14.0,14.0 0 1,0 -28.0,0" />

    <!-- verde, in basso a sinistra -->
    <path
        android:fillColor="#32974C"
        android:pathData="M40.0,68.0 m-14.0,0 a14.0,14.0 0 1,0 28.0,0 a14.0,14.0 0 1,0 -28.0,0" />

    <!-- viola, in basso a destra -->
    <path
        android:fillColor="#824FA5"
        android:pathData="M68.0,68.0 m-14.0,0 a14.0,14.0 0 1,0 28.0,0 a14.0,14.0 0 1,0 -28.0,0" />

    <!-- blu, al centro e sopra ai quattro -->
    <path
        android:fillColor="#067BC0"
        android:pathData="M54.0,54.0 m-14.0,0 a14.0,14.0 0 1,0 28.0,0 a14.0,14.0 0 1,0 -28.0,0" />

    <!-- ── Il badge ────────────────────────────────────────────────────────
         ⚠️ L'alone scuro non è un contorno decorativo, ed è la stessa ragione
         di SOS letta su un altro colore: il badge (#0F766E) e il cerchio rosso
         del marchio (#CA372E) che gli sta sotto hanno **quasi la stessa
         luminosità** — 0,141 contro 0,156 — quindi senza un bordo scuro in
         mezzo a 48 dp nel cassetto si leggerebbero come una macchia sola.
         Il verde petrolio è il colore di quest'app, lo stesso della barra di
         stato. -->
    <path
        android:fillColor="#22262A"
        android:pathData="M56.8,30 L74.2,30 A5.8,5.8 0 0 1 80,35.8 L80,49.2 A5.8,5.8 0 0 1 74.2,55 L56.8,55 A5.8,5.8 0 0 1 51,49.2 L51,35.8 A5.8,5.8 0 0 1 56.8,30 Z" />
    <path
        android:fillColor="#0F766E"
        android:pathData="M57,31 L74,31 A5,5 0 0 1 79,36 L79,49 A5,5 0 0 1 74,54 L57,54 A5,5 0 0 1 52,49 L52,36 A5,5 0 0 1 57,31 Z" />

    <!-- La chiave inglese, centrata in (65.5, 42.5) dentro il badge.
         Il pivot (57.1, 50.9) è il centro del riquadro che la chiave occupa a
         grandezza naturale, contorni dei tratti compresi; la scala 0.35 la
         porta a 17,4 unità di lato, cioè dentro il badge con un margine da
         ogni parte. Bianca su #0F766E fa 5,5:1, quindi si legge. -->
    <group
        android:name="chiave"
        android:pivotX="57.1"
        android:pivotY="50.9"
        android:scaleX="0.35"
        android:scaleY="0.35"
        android:translateX="8.4"
        android:translateY="-8.4">

        <!-- manico: la punta arrotondata è il cappuccio del tratto, non un secondo path -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="11"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M40,68 L63,45" />

        <!-- testa: un anello aperto verso l'alto a destra, come una chiave a forchetta.
             L'arco copre 290° (large-arc=1, sweep=1): il vuoto è la bocca. -->
        <path
            android:strokeColor="#FFFFFF"
            android:strokeWidth="8"
            android:strokeLineCap="round"
            android:fillColor="@android:color/transparent"
            android:pathData="M77.9,38.3 A10,10 0 1,1 69.7,30.2" />

    </group>

</vector>
