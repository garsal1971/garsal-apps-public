<?xml version="1.0" encoding="utf-8"?>
<!-- I cinque cerchi di AppSphere: quattro che si toccano a due a due e il blu
     al centro, sopra a tutti. È il disegno della foto di riferimento, ridotto
     alla geometria pulita — cerchi uguali di raggio 14 dp con i centri a
     ±14 dp dal centro della tela.

     ⚠️ Il raggio non è scelto a occhio: r·(1+√2) = 33.8 dp è la
     distanza dal centro dell'angolo più esterno, e deve stare dentro il
     **cerchio di sicurezza da 36 dp** dell'icona adattiva — oltre, la
     maschera tonda di certi launcher taglierebbe i quattro cerchi esterni. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- arancio, in alto a sinistra -->
    <path
        android:fillColor="#DE8026"
        android:pathData="M40.0,40.0 m-14.0,0 a14.0,14.0 0 1,0 28.0,0 a14.0,14.0 0 1,0 -28.0,0" />

    <!-- rosso, in alto a destra -->
    <path
        android:fillColor="#CA372E"
        android:pathData="M68.0,40.0 m-14.0,0 a14.0,14.0 0 1,0 28.0,0 a14.0,14.0 0 1,0 -28.0,0" />

    <!-- verde, in basso a sinistra -->
    <path
        android:fillColor="#32974C"
        android:pathData="M40.0,68.0 m-14.0,0 a14.0,14.0 0 1,0 28.0,0 a14.0,14.0 0 1,0 -28.0,0" />

    <!-- viola, in basso a destra -->
    <path
        android:fillColor="#824FA5"
        android:pathData="M68.0,68.0 m-14.0,0 a14.0,14.0 0 1,0 28.0,0 a14.0,14.0 0 1,0 -28.0,0" />

    <!-- blu, al centro e sopra a tutti -->
    <path
        android:fillColor="#067BC0"
        android:pathData="M54.0,54.0 m-14.0,0 a14.0,14.0 0 1,0 28.0,0 a14.0,14.0 0 1,0 -28.0,0" />
</vector>
